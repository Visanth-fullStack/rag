<Window x:Class="InterviewAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Interview Agent - Live Transcriber" Height="600" Width="800"
        Background="#F5F5F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button x:Name="StartButton" Content="Start Dual Transcription" Click="StartButton_Click" 
                    Width="200" Height="32" Margin="0,0,10,0" 
                    Background="#007AFF" Foreground="White" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
            
            <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" IsEnabled="False"
                    Width="80" Height="32" Margin="0,0,10,0" />

            <Button x:Name="ChatToggleButton" Content="Open Chat" Click="ChatToggleButton_Click"
                    Width="100" Height="32" Background="#34C759" Foreground="White" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ChatColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Transcription Area -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,10,0">
                <ScrollViewer x:Name="TranscriptionScrollViewer">
                    <TextBlock x:Name="TranscriptionText" TextWrapping="Wrap" FontSize="16" 
                               Text="Transcription will appear here..." Foreground="#666"/>
                </ScrollViewer>
            </Border>

            <!-- Chat Area -->
            <Border x:Name="ChatPanel" Grid.Column="1" Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Visibility="Collapsed">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="AI Assistant" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>
                    
                    <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer" Margin="0,0,0,10">
                        <ItemsControl x:Name="ChatItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,5" Padding="10" CornerRadius="8" 
                                            Background="{Binding BackgroundColor}"
                                            HorizontalAlignment="{Binding Alignment}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Sender}" FontSize="12" Foreground="#888" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="14" Foreground="Black"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput" Height="32" Padding="5,5" 
                                 KeyDown="ChatInput_KeyDown" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Send" Click="SendChat_Click" Margin="5,0,0,0" Width="60" Height="32"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="#888"/>
        </Grid>
    </Grid>
</Window>
